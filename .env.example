# Copy to .env and adjust. Never commit the real .env file.

# Comma-separated API keys. Leave empty to disable authentication (local development only!).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

DATABASE_URL=sqlite:///./data/geo_measure.db

# Limits
MAX_UPLOAD_MB=25
MAX_UNZIPPED_MB=200
MAX_ZIP_ENTRIES=200
MAX_COMPRESSION_RATIO=200
MAX_FEATURES=50000
MAX_VERTICES=5000000

# Abuse protection (requests per minute per client IP, 0 = off)
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# Hardening for production
ENABLE_DOCS=true
ALLOWED_HOSTS=*
CORS_ORIGINS=
